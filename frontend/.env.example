# EduOS Multi-Tenant Database Credentials
# Copy this file to .env.local and replace with your actual Supabase project keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anonymous-anon-key-string

# ---------------------------------------------------------------------------
# EDUOS-102 — Authentication
# ---------------------------------------------------------------------------
# Leaving both values at their placeholders keeps the app in the fixture
# sandbox: no login, a demo session, and a permanent banner saying so.
#
# Setting them to a real project turns authentication ON everywhere at once:
#   - middleware.ts redirects unauthenticated requests to /login
#   - the sidebar offers only roles the signed-in user actually holds
#   - the demo session becomes unreachable
#
# Before the first real sign-in, run BOTH SQL files in the Supabase SQL editor,
# in order:
#   1. supabase/schema.sql
#   2. supabase/migrations/EDUOS-102-auth.sql
#
# Access is invite-first, never self-serve. Create the profile row before the
# person signs up, so signup attaches to a tenant that already granted them
# access rather than letting them name their own:
#
#   INSERT INTO public.user_profiles
#       (tenant_id, branch_id, email, first_name, last_name, role)
#   VALUES
#       ('<tenant-uuid>', NULL, 'principal@school.edu.in', 'Asha', 'Rao', 'principal');
#
# Then invite that address from Supabase Auth (Authentication -> Users ->
# Invite). The on_auth_user_created trigger links the two by email.
#
# Valid roles: student, parent, teacher, principal, hr_manager, finance,
# super_admin. `finance` is accepted by the database but has no dashboard until
# EDUOS-123, so such a user signs in and resolves to "no access" by design.
